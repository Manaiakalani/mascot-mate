# OpenAI is the default. Leave this unset and set XAI_API_KEY to use api.x.ai instead.
OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...
# OPENAI_BASE_URL=https://api.x.ai/v1
OPENAI_MODEL=gpt-4o-mini
# Cap completion length. Set to 0 to omit max_tokens.
OPENAI_MAX_TOKENS=512
# Abort the upstream call if it sends no bytes for this long.
OPENAI_TIMEOUT_MS=45000
# Optional. When set, the widget must send the same value as data-token / MascotInitOptions.token.
# ASK_TOKEN=
# Optional. Replaces the system prompt the browser sends.
# SYSTEM_PROMPT=You are a friendly retro desktop assistant. Keep answers short.
ALLOWED_ORIGINS=http://localhost:5173,https://your-site.example
RATE_LIMIT_RPM=20
PORT=8787
